<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenCNCPilot.UI.ViewModels"
             xmlns:ac="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             xmlns:local="using:OpenCNCPilot.UI.Views.Controls"
             x:Class="OpenCNCPilot.UI.Views.FilePanel"
             x:Name="Root"
             x:DataType="vm:FileViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnDefinitions="*,Auto">
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
      <Button Content="Open" Command="{Binding OpenCommand}"/>
      <Button Content="Save" Command="{Binding SaveCommand}"/>
      <Button Content="Clear" Command="{Binding ClearCommand}"/>
      <Button Content="Start" Command="{Binding StartCommand}"/>
      <Button Content="Pause" Command="{Binding PauseCommand}"/>
      <Button Content="Go To" Command="{Binding GotoCommand}"/>
      <CheckBox Content="Pause on M0/M1/M30" IsChecked="{Binding PauseOnHold}"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16" Margin="0,8,0,8">
      <TextBlock Text="File:" FontWeight="Bold"/>
      <TextBlock Text="{Binding CurrentFileName}"/>
      <TextBlock Text=" | Pos:"/>
      <TextBlock Text="{Binding FilePosition}"/>
      <TextBlock Text="/"/>
      <TextBlock Text="{Binding FileLength}"/>
      <TextBlock Text=" | Runtime:"/>
      <TextBlock Text="{Binding Runtime}"/>
      <TextBlock Text=" | ETA:"/>
      <TextBlock Text="{Binding EstimatedDuration}"/>
    </StackPanel>

    <!-- Search Bar -->
    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="Find:" VerticalAlignment="Center"/>
  <TextBox Width="240" Text="{Binding SearchQuery, Mode=TwoWay}" Watermark="text or command"/>
      <Button Content="Prev" Command="{Binding FindPrevCommand}"/>
      <Button Content="Next" Command="{Binding FindNextCommand}"/>
      <TextBlock Text="{Binding SearchStatus}" VerticalAlignment="Center" Opacity="0.7"/>
    </StackPanel>

    <!-- Loading Indicator -->
    <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <ProgressBar IsIndeterminate="True" Minimum="0" Maximum="1" Value="{Binding LoadProgress}"
                   IsVisible="{Binding IsLoading}" Height="8" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelLoadCommand}"
              IsVisible="{Binding IsLoading}"/>
    </Grid>

  <ListBox Grid.Row="4" Grid.ColumnSpan="2"
           ItemsSource="{Binding GCodeLines}"
           SelectedIndex="{Binding FilePosition}"
           Tag="{Binding SearchQuery}"
           ScrollViewer.VerticalScrollBarVisibility="Auto">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <ac:VirtualizingStackPanel/>
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.ItemTemplate>
      <DataTemplate>
        <local:HighlightTextBlock TextSource="{Binding .}" Query="{Binding $parent[ListBox].Tag}"/>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>

    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="MVP: Vista de archivo y comandos básicos" Opacity="0.6"/>
  </Grid>
  <UserControl.KeyBindings>
    <KeyBinding Gesture="F3" Command="{Binding FindNextCommand}"/>
    <KeyBinding Gesture="Shift+F3" Command="{Binding FindPrevCommand}"/>
  </UserControl.KeyBindings>
</UserControl>
