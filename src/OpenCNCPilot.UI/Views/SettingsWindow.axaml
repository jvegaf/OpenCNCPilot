<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ac="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        xmlns:vm="using:OpenCNCPilot.UI.ViewModels"
        x:Class="OpenCNCPilot.UI.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Title="Settings" Width="500" Height="350">

  <Design.DataContext>
    <vm:SettingsWindowViewModel/>
  </Design.DataContext>

  <Grid RowDefinitions="* , Auto" Margin="16">
    <StackPanel Spacing="10">
      <TextBlock Text="Serial Settings" FontWeight="Bold" FontSize="14"/>
  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Default COM Port:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DefaultComPort}"/>

  <TextBlock Grid.Row="1" Grid.Column="0" Text="Baud Rate:" VerticalAlignment="Center"/>
  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BaudRate}" Watermark="115200"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Last GCode Directory:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LastGCodeDirectory}"/>

  <TextBlock Grid.Row="3" Grid.Column="0" Text="Viewer Rotate Sensitivity:" VerticalAlignment="Center"/>
  <ac:NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding ViewerRotateSensitivity}"
        Minimum="0.05" Maximum="2.0" Increment="0.05" FormatString="F2"
        ToolTip.Tip="Rango recomendado: 0.05 – 2.0"/>

  <TextBlock Grid.Row="4" Grid.Column="0" Text="Viewer Pan Sensitivity:" VerticalAlignment="Center"/>
  <ac:NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding ViewerPanSensitivity}"
        Minimum="0.001" Maximum="1.0" Increment="0.001" FormatString="F3"
        ToolTip.Tip="Rango recomendado: 0.001 – 1.0"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Viewer Zoom Step Factor:" VerticalAlignment="Center"/>
        <ac:NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding ViewerZoomStepFactor}"
                          Minimum="1.01" Maximum="1.5" Increment="0.01" FormatString="F2"
                          ToolTip.Tip="Rango recomendado: 1.01 – 1.5"/>
      </Grid>
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button Content="Cancel" Command="{Binding CancelCommand}"/>
      <Button Content="Save" Command="{Binding SaveCommand}"/>
    </StackPanel>
  </Grid>
</Window>
