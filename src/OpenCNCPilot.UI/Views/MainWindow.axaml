<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenCNCPilot.UI.ViewModels"
        xmlns:converters="using:OpenCNCPilot.UI.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:OpenCNCPilot.UI.Views.Controls"
  xmlns:ac="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="OpenCNCPilot.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
  Title="{Binding WindowTitle}"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600">

  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <DockPanel>
    <!-- Status Bar at Top -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
            Padding="10,5" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="0,0,0,1">
  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <!-- Connection Controls -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <ComboBox ItemsSource="{Binding AvailablePorts}"
                    SelectedItem="{Binding SelectedPort}"
                    PlaceholderText="Select Port"
                    MinWidth="120"/>
          <Button Content="Refresh" Command="{Binding RefreshPortsCommand}" />
          <Button Content="Connect" Command="{Binding ConnectCommand}"
                  IsEnabled="{Binding CanConnect}"/>
          <Button Content="Disconnect" Command="{Binding DisconnectCommand}"
                  IsEnabled="{Binding IsConnected}"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Column="1" Text="{Binding Status}"
                   VerticalAlignment="Center" Margin="20,0"/>

        <!-- Position Display -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="15" Margin="20,0">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="Machine:" FontWeight="Bold"/>
            <TextBlock Text="{Binding MachinePosition.X, StringFormat=X: {0:F3}}"/>
            <TextBlock Text="{Binding MachinePosition.Y, StringFormat=Y: {0:F3}}"/>
            <TextBlock Text="{Binding MachinePosition.Z, StringFormat=Z: {0:F3}}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="Work:" FontWeight="Bold"/>
            <TextBlock Text="{Binding WorkPosition.X, StringFormat=X: {0:F3}}"/>
            <TextBlock Text="{Binding WorkPosition.Y, StringFormat=Y: {0:F3}}"/>
            <TextBlock Text="{Binding WorkPosition.Z, StringFormat=Z: {0:F3}}"/>
          </StackPanel>
        </StackPanel>

        <!-- Settings Buttons -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
          <Button Content="Settings" Command="{Binding OpenSettingsCommand}"/>
          <Button Content="GRBL Settings" Command="{Binding OpenGrblSettingsCommand}"/>
        </StackPanel>

        <!-- Connection Indicator -->
        <Border Grid.Column="4" Width="12" Height="12" CornerRadius="6" Margin="10,0">
          <Border.Background>
            <SolidColorBrush Color="{Binding IsConnected, Converter={x:Static converters:BooleanToColorConverter.Instance},
                                            ConverterParameter=Green|Red}"/>
          </Border.Background>
        </Border>
      </Grid>
    </Border>

    <!-- Main Content Area -->
    <TabControl DockPanel.Dock="Bottom">
      <!-- Machine Tab -->
      <TabItem Header="Machine">
        <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,300" Margin="10">
          <!-- Control Panel -->
          <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                  Padding="10" CornerRadius="5" Margin="10,0,0,10">
            <StackPanel Spacing="10">
              <TextBlock Text="Machine Control" FontWeight="Bold" FontSize="16"/>

              <!-- Manual Control -->
              <Expander Header="Manual Control" IsExpanded="True">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*,*" Margin="0,10,0,0">
                  <!-- XY Control -->
                  <Button Grid.Row="0" Grid.Column="1" Content="Y+" Margin="2"/>
                  <Button Grid.Row="1" Grid.Column="0" Content="X-" Margin="2"/>
                  <Button Grid.Row="1" Grid.Column="1" Content="Home" Margin="2"/>
                  <Button Grid.Row="1" Grid.Column="2" Content="X+" Margin="2"/>
                  <Button Grid.Row="2" Grid.Column="1" Content="Y-" Margin="2"/>

                  <!-- Z Control (separate area) -->
                  <StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" Spacing="5" Margin="10,0,0,0">
                    <Button Content="Z+" />
                    <Button Content="Z-" />
                  </StackPanel>
                </Grid>
              </Expander>

              <!-- File Operations -->
              <Expander Header="File Operations">
                <StackPanel Spacing="5" Margin="0,10,0,0">
                  <Button Content="Load G-Code File" Command="{Binding LoadGCodeFileCommand}" />
                  <Button Content="Load Height Map" />
                  <Button Content="Show Parse Warnings (Demo)" Command="{Binding DemoWarningsCommand}" />
                  <TextBlock Text="No file loaded" FontStyle="Italic" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

      <!-- Main Visualization Area -->
      <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
      Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
      BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
      BorderThickness="1" CornerRadius="5">
  <Grid>
  <controls:GCodeViewport Commands="{Binding GCodeCommands}"
               Zoom="{Binding ViewerZoom}"
               RotationX="{Binding ViewerRotationX}"
               RotationY="{Binding ViewerRotationY}"
               PanX="{Binding ViewerPanX}"
               PanY="{Binding ViewerPanY}"
               FitRequestId="{Binding FitRequestId}"
               RotateSensitivity="{Binding ViewerRotateSensitivity}"
               PanSensitivity="{Binding ViewerPanSensitivity}"
               ZoomStepFactor="{Binding ViewerZoomStepFactor}"
               ShowGrid="{Binding ViewerShowGrid}"
               ShowOrigin="{Binding ViewerShowOrigin}"
               ShowBounds="{Binding ViewerShowBounds}"
               GridMinPixelStep="{Binding ViewerGridMinPixelStep}" />
    <!-- Overlay zoom toolbar -->
    <StackPanel Orientation="Horizontal" Spacing="6" Margin="10"
                HorizontalAlignment="Right" VerticalAlignment="Top">
  <Button Content="Fit" Command="{Binding FitToViewCommand}"/>
  <Button Content="Fit+Reset" Command="{Binding FitAndResetViewCommand}" ToolTip.Tip="Reinicia vista y ajusta límites"/>
      <Button Content="-" Width="28" Command="{Binding ZoomOutCommand}"/>
      <Button Content="+" Width="28" Command="{Binding ZoomInCommand}"/>
      <Button Content="100%" Command="{Binding ZoomResetCommand}"/>
  <Button Content="Reset" Command="{Binding ResetViewCommand}"/>
  <Button Content="⟲" Width="28" Command="{Binding RotateLeftCommand}"/>
      <Button Content="⟳" Width="28" Command="{Binding RotateRightCommand}"/>
      <Button Content="↑" Width="28" Command="{Binding RotateUpCommand}"/>
      <Button Content="↓" Width="28" Command="{Binding RotateDownCommand}"/>
  <Button Content="⊟ 2D" Command="{Binding SnapTo2DCommand}" ToolTip.Tip="Vista ortográfica (X-Y)"/>
      <Button Content="←" Width="28" Command="{Binding PanLeftCommand}"/>
      <Button Content="→" Width="28" Command="{Binding PanRightCommand}"/>
      <Button Content="⇑" Width="28" Command="{Binding PanUpCommand}"/>
      <Button Content="⇓" Width="28" Command="{Binding PanDownCommand}"/>
      <TextBlock Text="|" Margin="6,0" VerticalAlignment="Center" Opacity="0.5"/>
      <ToggleButton Content="▦ Grid" IsChecked="{Binding ViewerShowGrid}"
                    ToolTip.Tip="Mostrar/Ocultar grilla"/>
      <ToggleButton Content="⊕ Origin" IsChecked="{Binding ViewerShowOrigin}"
                    ToolTip.Tip="Mostrar/Ocultar origen (0,0)"/>
      <ToggleButton Content="▣ Bounds" IsChecked="{Binding ViewerShowBounds}"
                    ToolTip.Tip="Mostrar/Ocultar límites del G-Code"/>
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
        <TextBlock Text="Grid px:" VerticalAlignment="Center"/>
        <ac:NumericUpDown Value="{Binding ViewerGridMinPixelStep}"
                           Minimum="4" Maximum="200" Increment="2" Width="80" FormatString="F0"
                           ToolTip.Tip="Tamaño mínimo en píxeles entre líneas de grilla"/>
      </StackPanel>
    </StackPanel>
  </Grid>
      </Border>

          <!-- Log/Console Area -->
          <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                  Padding="10" CornerRadius="5" Margin="10,10,0,0">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Text="Console" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
              <ScrollViewer Grid.Row="1">
                <TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         Text="OpenCNCPilot Cross-Platform v2.0&#x0A;Ready for connection...&#x0A;"
                         Background="Transparent" BorderThickness="0"/>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- File Tab -->
      <TabItem Header="File">
        <Grid Margin="10">
          <TextBlock Text="File management and G-Code preview&#x0A;(To be implemented)"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="16" Opacity="0.7" TextAlignment="Center"/>
        </Grid>
      </TabItem>

      <!-- Probing Tab -->
      <TabItem Header="Probing">
        <Grid Margin="10">
          <TextBlock Text="Height map probing and auto-leveling&#x0A;(To be implemented)"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="16" Opacity="0.7" TextAlignment="Center"/>
        </Grid>
      </TabItem>

      <!-- Settings Tab -->
      <TabItem Header="Settings">
        <Grid Margin="10">
          <TextBlock Text="Application and GRBL settings&#x0A;(To be implemented)"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="16" Opacity="0.7" TextAlignment="Center"/>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
